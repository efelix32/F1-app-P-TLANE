{
  "name": "f1-dashboard",
  "version": "1.1.0",
  "type": "module",
  "description": "A modern, real-time Formula 1 companion app built with React. Track standings, drivers, circuits, and manage your fantasy F1 team.",
  "author": "efelix32",
  "license": "MIT",
  "homepage": "https://pitlanef1.vercel.app",
  "keywords": ["formula1", "f1", "react", "vite", "firebase", "pwa", "openf1", "dashboard"],
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .js,.jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "format": "prettier --write src/**/*.{js,jsx}"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.12.2",
    "firebase": "^12.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.17",
    "vite": "^4.5.14",
    "vitest": "^3.2.4"
  }
}
